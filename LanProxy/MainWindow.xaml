<Window x:Class="LanProxy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="LanProxy 局域网代理服务器" Height="660" Width="920"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/app.ico"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧设置面板（仿 CCProxy） ===== -->
            <Border Grid.Column="0" Background="#F2F4F8" BorderBrush="#D8DCE4" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="局域网代理服务器" FontSize="16" FontWeight="Bold" Foreground="#1F4E8C"/>
                    <TextBlock Text="HTTP / SOCKS5 共享代理" FontSize="11" Foreground="#777" Margin="0,2,0,14"/>

                    <TextBlock Text="网卡 / 本机 IP" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboAdapter" Height="30" VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SubText" Text="{Binding SubLine}" FontSize="11" Foreground="Gray"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBoxItem}}" Value="True">
                                        <Setter TargetName="SubText" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBoxItem}}" Value="False">
                                        <Setter TargetName="SubText" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUp}" Value="False">
                                        <Setter Property="Foreground" Value="Gray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBlock Text="HTTP 代理端口" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBox x:Name="TxtHttpPort" Text="8080" Height="26" VerticalContentAlignment="Center"/>

                    <TextBlock Text="SOCKS5 代理端口" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBox x:Name="TxtSocksPort" Text="1080" Height="26" VerticalContentAlignment="Center"/>

                    <Button x:Name="BtnCopy" Content="复制当前网卡 IP" Height="32" Margin="0,16,0,0" Click="BtnCopy_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnStart" Content="启动代理" Height="32" Width="100" Margin="0,0,8,0" Click="BtnStart_Click"/>
                        <Button x:Name="BtnStop" Content="停止代理" Height="32" Width="100" IsEnabled="False" Click="BtnStop_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <CheckBox x:Name="ChkLog" Content="显示日志" IsChecked="True" Checked="ChkLog_Toggled" Unchecked="ChkLog_Toggled"/>
                        <CheckBox x:Name="ChkTray" Content="托盘显示" Margin="14,0,0,0"
                                  Checked="ChkTray_Toggled" Unchecked="ChkTray_Toggled"
                                  ToolTip="勾选后立即在托盘区显示图标；点窗口关闭按钮，程序最小化到托盘继续运行，双击托盘图标恢复"/>
                    </StackPanel>

                    <TextBlock Text="提示：启动前请确保 Windows 防火墙已放行上述端口，局域网设备才能接入。" 
                               TextWrapping="Wrap" FontSize="11" Foreground="#999" Margin="0,14,0,0"/>
                    <TextBlock Text="勾选「托盘显示」后，点窗口关闭按钮，软件会在托盘区继续运行（不退出），双击托盘图标恢复界面。"
                               TextWrapping="Wrap" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== 右侧主区域 ===== -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="190"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0">
                    <TabItem Header="实时流量">
                        <oxy:PlotView x:Name="PlotTraffic" Background="White"/>
                    </TabItem>
                    <TabItem Header="客户端连接">
                        <DataGrid x:Name="GridClients" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="24" AlternatingRowBackground="#F7F8FA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="客户端 IP" Binding="{Binding ClientIp}" Width="*"/>
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="90"/>
                                <DataGridTextColumn Header="已上传" Binding="{Binding UploadText}" Width="120"/>
                                <DataGridTextColumn Header="已下载" Binding="{Binding DownloadText}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <Border x:Name="LogPanel" Grid.Row="1" Margin="0,10,0,0" BorderBrush="#D8DCE4" BorderThickness="1"
                        CornerRadius="4" Padding="6" Background="#FCFCFC">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="运行日志" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="未启动"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtTotal" Text="上行 0 B · 下行 0 B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
